<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
     <%- include('./partials/navbar') %>

    <h1>Dish Details</h1>
    <p>Name: <%= Food.name %></p>
    <p>Description: <%= Food.description %></p>
    <p>ID: <%= Food._id %></p>
    <p>Price: <%= Food.price %></p>
    <p>Category: <%= Food.category %></p>
    <p>Calories: <%= Food.calories %></p>
    <p>Last Update: <%= Food.updatedAt %></p>

    <form action="/dishes/<%= Food._id %>/?_method=DELETE" method="post">
        <button>Delete dish</button>
    </form>


    <form action="/dishes/<%= Food._id %>/edit?_method=PUT" method="get">
    <button type="submit">Edit dish</button>
    </form>
</body>
</html>